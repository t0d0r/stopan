# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config and gems installed on the host.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore development files
/.devcontainer

# Ignore project notes that the image does not need
/specs
/todo
/session

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
/compose.yaml

# Screenshots for the README.
/docs/

# Ignore agent and editor working folders, git hooks and other VCS files.
/.hermes
/.claude
/.githooks
/.hgignore
/.github

# Ignore tests and server deployment files; the image only runs the app.
/test
/deploy
/AGENTS.md
