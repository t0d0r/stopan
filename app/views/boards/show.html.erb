<% content_for :title, t("ui.board.title") %>
<% content_for :body_class, "board-page" %>
<% turbo_refreshes_with scroll: :preserve %>
<%= turbo_stream_from(:queue, :staff, channel: TicketListsChannel) %>
<% filter = @board.filter %>
<%# One row: the filters, then the List | Board switch (specs/board.md). %>
<div class="desk__header board-header">
  <%# The menu bar and the List | Board switch name the page; the h1 is for screen readers (ui.md "Pages"). %>
  <h1 class="sr-only"><%= t("ui.board.title") %></h1>
  <%= render "tickets/filters", filter: filter, staff: @staff, url: board_path, view: nil, clear_path: board_path,
                                form_class: "board-filters" %>
  <%= render "tickets/view_switch", current: :board %>
</div>

<%# Shown while cards are ticked (specs/board.md "Several cards at once"). %>
<%= form_with url: bulk_tickets_path, method: :patch, id: "board-bulk", class: "bulk-bar board-bulk", hidden: true,
              data: { board_bulk: true, selected_one: t("ui.bulk.selected.one"), selected_other: t("ui.bulk.selected.other") } do %>
  <p class="bulk-bar__count" data-board-count aria-live="polite"></p>
  <div class="bulk-bar__fields">
    <%= label_tag "board_bulk_status", t("ui.board.move_to"), class: "sr-only" %>
    <%= select_tag "changes[status]", options_for_select(Ticket::STATUSES.map { |status| [ status_name(status), status ] }),
                   include_blank: t("ui.board.move_to"), id: "board_bulk_status", class: "select", required: true %>
    <%= submit_tag t("ui.board.move"), name: nil, class: "btn btn--primary" %>
    <button type="button" class="btn" data-board-clear><%= t("ui.bulk.clear") %></button>
  </div>
<% end %>

<div class="board" data-board data-transitions="<%= Ticket::TRANSITIONS.to_json %>" data-move-failed="<%= t("ui.board.move_failed") %>"
     data-drag-count="<%= t("ui.board.drag_count") %>" data-some-refused="<%= t("ui.board.some_refused") %>">
  <% @board.columns.each do |column| %>
    <% color = column.stage ? column.stage.color : TicketsHelper::STATUS_COLORS.fetch(column.status, "gray") %>
    <% name = column.stage ? "#{status_name(column.status)} / #{column.stage.name}" : status_name(column.status) %>
    <section class="board-column sticky--<%= color %><%= " is-collapsed" if column.collapsed? %><%= " board-column--stage" if column.stage %>"
             data-board-column data-status="<%= column.status %>" data-stage="<%= column.stage&.id %>" data-key="<%= column.key %>"
             aria-label="<%= name %>">
      <button type="button" class="board-pill" data-board-toggle aria-expanded="false"
              title="<%= t("ui.board.expand", status: name) %>">
        <span class="board-pill__count" data-column-count><%= column.count %></span>
        <span class="board-pill__label"><%= column.stage ? column.stage.name : status_name(column.status) %></span>
      </button>
      <div class="board-column__body">
        <header class="board-column__head" data-board-toggle title="<%= t("ui.board.collapse", status: name) %>">
          <h2 class="board-column__title"><% if column.stage %><span class="board-column__parent"><%= status_name(column.status) %> /</span> <%= column.stage.name %><% else %><%= status_name(column.status) %><% end %></h2>
          <span class="board-column__count" data-column-count><%= column.count %></span>
          <button type="button" class="sticky__box board-column__collapse" data-board-toggle aria-expanded="true"
                  title="<%= t("ui.board.collapse", status: name) %>" aria-label="<%= t("ui.board.collapse", status: name) %>">&ndash;</button>
        </header>
        <div class="board-column__cards" data-board-cards>
          <% column.tickets.each do |ticket| %>
            <%= render "boards/card", ticket: ticket, stages: @board.stages %>
          <% end %>
          <% if column.tickets.empty? %><p class="board-column__empty"><%= t("ui.board.empty") %></p><% end %>
        </div>
        <% if column.more.positive? %>
          <p class="board-column__more"><%= link_to t("ui.board.more", count: column.more), tickets_path(filter.params_with(view: "done", status: nil, page: nil)) %></p>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
