<%# Sun/moon theme switch, text size menu and language switch. All are form
    buttons (no JavaScript needed); application.js applies all but the
    language at once and sets the same cookies. %>
<%= form_with url: preferences_path, method: :patch, class: "prefs", data: { preference: true } do %>
  <%# Only one button shows, depending on the current theme (application.css). %>
  <button type="submit" name="theme" value="dark" class="tool-button theme-toggle theme-toggle--to-dark"
          title="<%= t("ui.prefs.dark") %>" aria-label="<%= t("ui.prefs.dark") %>"><%= icon :moon, size: 15 %></button>
  <button type="submit" name="theme" value="light" class="tool-button theme-toggle theme-toggle--to-light"
          title="<%= t("ui.prefs.light") %>" aria-label="<%= t("ui.prefs.light") %>"><%= icon :sun, size: 15 %></button>
  <%# Width switch (ui.md): only the button for the other width shows. %>
  <button type="submit" name="width" value="wide" class="tool-button width-toggle width-toggle--to-wide"
          title="<%= t("ui.prefs.wide") %>" aria-label="<%= t("ui.prefs.wide") %>"><%= icon :widen, size: 15 %></button>
  <button type="submit" name="width" value="normal" class="tool-button width-toggle width-toggle--to-normal"
          title="<%= t("ui.prefs.narrow") %>" aria-label="<%= t("ui.prefs.narrow") %>"><%= icon :narrow, size: 15 %></button>
  <%# Three A buttons of growing size: Normal, Big, Extra big. %>
  <span class="scale-buttons" role="group" aria-label="<%= t("ui.prefs.text_size") %>">
    <% PreferencesController::SCALES.each do |scale| %>
      <button type="submit" name="scale" value="<%= scale %>" class="tool-button scale-button scale-button--<%= scale %>"
              aria-pressed="<%= scale == scale_preference %>" title="<%= t("ui.prefs.scales.#{scale}") %>"
              aria-label="<%= t("ui.prefs.text_size") %>: <%= t("ui.prefs.scales.#{scale}") %>">A</button>
    <% end %>
  </span>
  <%# The other language, named in itself (ui.md "Language"); the page reloads. %>
  <% language = other_language %>
  <button type="submit" name="locale" value="<%= language %>" class="tool-button language-switch" lang="<%= language %>" data-turbo="false"
          title="<%= ApplicationHelper::LANGUAGE_NAMES[language] %>" aria-label="<%= ApplicationHelper::LANGUAGE_NAMES[language] %>"><%= language.upcase %></button>
<% end %>
