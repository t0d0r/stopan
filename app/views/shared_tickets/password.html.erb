<% content_for :title, t("ui.share.locked_title") %>
<section class="sticky sticky--yellow panel panel--narrow" aria-labelledby="locked-title">
  <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.share.shared_ticket") %></span></header>
  <div class="panel__body">
    <h1 class="panel__title" id="locked-title"><%= icon :lock %> <%= t("ui.share.locked_title") %></h1>
    <p class="panel__intro"><%= t("ui.share.locked_hint") %></p>
    <%= form_with url: unlock_shared_ticket_path(@ticket.share_token), class: "stack-form", id: "unlock_form" do %>
      <div class="field">
        <%= label_tag :password, t("ui.fields.password") %>
        <%# The eye shows what was typed (specs/sharing.md "Show what was typed"). %>
        <div class="password-field" data-password-field>
          <%= password_field_tag :password, nil, autofocus: true, autocomplete: "off", required: true, class: "field-input" %>
          <button type="button" class="password-field__toggle" data-password-toggle hidden aria-pressed="false"
                  aria-controls="password" aria-label="<%= t("ui.share.show_password") %>" title="<%= t("ui.share.show_password") %>"
                  data-show-label="<%= t("ui.share.show_password") %>" data-hide-label="<%= t("ui.share.hide_password") %>">
            <span class="password-field__show"><%= icon :eye, size: 16 %></span>
            <span class="password-field__hide"><%= icon :eye_off, size: 16 %></span>
          </button>
        </div>
      </div>
      <div class="form-actions">
        <%= submit_tag t("ui.share.unlock"), class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</section>
