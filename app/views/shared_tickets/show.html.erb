<% content_for :title, "#{@ticket.reference} #{@ticket.subject}" %>
<% turbo_refreshes_with scroll: :preserve %>
<%= turbo_stream_from(*@ticket.share_stream, channel: SharedTicketChannel, data: { ticket: @ticket.number }) %>
<div class="ticket-page ticket-page--shared">
  <header class="ticket-head">
    <p class="callout shared-note"><%= icon :link %> <%= t("ui.share.public_note", reference: @ticket.reference) %></p>
    <%# This page subscribes after it loads, so it counts itself. %>
    <%= share_viewers_tag ShareViewers.count(@ticket) + 1, scope: :page %>
    <h1 class="ticket-head__title"><%= @ticket.subject %></h1>
    <p class="ticket-head__meta">
      <span class="ticket-number"><%= @ticket.reference %></span>
      <%= status_pill @ticket.status %>
      <span><%= t("ui.ticket.opened_by", name: @ticket.requester.display_name) %> <%= time_ago @ticket.created_at %></span>
    </p>
  </header>

  <div class="ticket-main">
    <article class="sticky sticky--yellow message message--description" id="description">
      <%= render "tickets/message_bar", record: @ticket, author: @ticket.requester, kind: t("ui.ticket.description"),
                 icon_name: :note, width_box: true %>
      <div class="message__body">
        <%= message_text @ticket %>
        <% if @ticket.files.attached? %>
          <ul class="file-list" aria-label="<%= t("ui.fields.files") %>">
            <% @ticket.files.each do |file| %>
              <li><%= attachment_link @ticket, file, share_token: @ticket.share_token %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </article>

    <h2 class="section-heading" id="timeline-title"><%= t("ui.timeline.title") %></h2>
    <ol class="timeline" aria-labelledby="timeline-title">
      <% @events.each do |event| %>
        <%= render "tickets/event", event: event, ticket: @ticket, share_token: @ticket.share_token %>
      <% end %>
    </ol>
  </div>
</div>
