<h2><%= t("ui.account_page.title") %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= form_errors resource %>

  <div class="field">
    <%= f.label :name, t("ui.fields.name") %>
    <%= f.text_field :name, autocomplete: "name", maxlength: 120 %>
  </div>

  <div class="field">
    <%= f.label :email, t("ui.fields.email") %>
    <%= f.email_field :email, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password, t("ui.new_password") %>
    <i><%= t("ui.account_page.password_keep") %></i>
    <%= f.password_field :password, autocomplete: "new-password" %>
    <% if @minimum_password_length %>
      <em><%= t("ui.password_minimum", count: @minimum_password_length) %></em>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, t("ui.confirm_new_password") %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <% if resource.password_chosen? %>
    <div class="field">
      <%= f.label :current_password, t("ui.account_page.current_password") %>
      <i><%= t("ui.account_page.current_password_hint") %></i>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>
  <% else %>
    <p class="field-hint"><%= t("ui.account_page.first_password_hint") %></p>
  <% end %>

  <div class="actions">
    <%= f.submit t("ui.save") %>
  </div>
<% end %>

<%= form_with model: resource, url: user_language_path, method: :patch, id: "language" do |f| %>
  <h3><%= t("ui.account_page.language") %></h3>
  <div class="field">
    <%= f.label :language, t("ui.account_page.language"), class: "sr-only" %>
    <%= f.select :language, [ [ t("ui.account_page.browser_language"), "" ] ] + ApplicationHelper::LANGUAGE_NAMES.invert.to_a,
                 {}, class: "select" %>
    <i><%= t("ui.account_page.language_hint") %></i>
  </div>
  <div class="actions">
    <%= f.submit t("ui.account_page.save_language") %>
  </div>
<% end %>

<% if resource.staff? %>
  <%= form_with model: resource, url: user_notifications_path, method: :patch, id: "notifications" do |f| %>
    <h3><%= t("ui.account_page.notifications") %></h3>
    <div class="field">
      <%= f.check_box :notify_new_tickets %><%= f.label :notify_new_tickets, t("ui.account_page.notify_new_tickets") %>
      <i><%= t("ui.account_page.notifications_hint") %></i>
    </div>
    <div class="actions">
      <%= f.submit t("ui.account_page.save_notifications") %>
    </div>
  <% end %>
<% end %>

<p class="auth__meta"><%= t("ui.account_page.organizations") %>:
  <%= resource.organizations.map(&:name).join(", ").presence || t("ui.account_page.no_organizations") %></p>
<div class="auth__links"><%= link_to t("ui.account_page.back"), root_path %></div>
