<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= theme_preference %>" data-scale="<%= scale_preference %>" data-width="<%= width_preference %>" data-look="<%= look_preference %>">
<head>
  <title><%= [content_for(:title), "Stopan"].compact_blank.join(" - ") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%# No page snapshots: a back or forward visit always fetches the page, so
      nothing stays cached after sign-out or after a ticket changes. %>
  <meta name="turbo-cache-control" content="no-cache">
  <%= yield :head %>
  <% if live_admin_page? %><%= turbo_refresh_scroll_tag :preserve %><% end %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%# Without JavaScript the phone menu and the ticket page's closed panels
      stay open (ui.md "Ticket page on phones"). %>
  <noscript><%= stylesheet_link_tag "noscript" %></noscript>
  <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
  <%# data-turbo-eval=false: Turbo shows an error page by swapping the whole
      document, which would run this script a second time. %>
  <%= javascript_include_tag "application", defer: true, "data-turbo-track": "reload", "data-turbo-eval": "false" %>
</head>
<body class="<%= content_for(:body_class) %>">
  <a class="skip-link" href="#main"><%= t("ui.skip_to_content") %></a>
  <header class="menubar">
    <%= link_to root_path, class: "menubar__brand", aria: { label: "Stopan" } do %>
      <%= image_tag "/icon.svg", alt: "", width: 18, height: 18 %><span class="menubar__name">Stopan</span>
    <% end %>
    <% if user_signed_in? && !without_organization? %>
      <nav class="menubar__nav" aria-label="<%= t("ui.nav.label") %>">
        <%= nav_link current_user.staff? ? t("ui.nav.queue") : t("ui.nav.my_tickets"), tickets_path, dot: "yellow",
                     current: current_section == :tickets %>
        <% if current_user.staff? %>
          <%= nav_link t("ui.nav.board"), board_path, dot: "purple", current: current_section == :board %>
          <%= nav_link t("ui.nav.search"), search_path, dot: "pink", current: current_section == :search %>
        <% end %>
        <%= nav_link t("ui.nav.new_ticket"), new_ticket_path, dot: "green", current: current_section == :new_ticket %>
        <% if current_user.staff? %>
          <%= nav_link t("ui.nav.reports"), reports_path, dot: "blue", current: current_section == :reports %>
        <% end %>
        <% if current_user.admin? %>
          <%= nav_link t("ui.nav.admin"), admin_root_path, dot: "gray", current: current_section == :admin %>
        <% end %>
      </nav>
      <%# The search page has its own field (queues.md "Search page"). %>
      <%= render "partials/search" unless current_section == :search %>
    <% end %>
    <div class="menubar__right">
      <% if user_signed_in? && !without_organization? %>
        <% if current_user.staff? %><%= render "presence/menu" %><% end %>
        <%= render "partials/notifications" %>
      <% end %>
      <%# Phones: the sections, preferences and account sit behind this button (ui.md "Menu bar"). %>
      <button type="button" class="tool-button menubar__burger" aria-label="<%= t("ui.nav.menu") %>" aria-expanded="false"
              data-menu-toggle><%= icon :menu, size: 18 %></button>
      <%= render "partials/preferences" %>
      <% if user_signed_in? %>
        <%= link_to edit_user_registration_path, class: "menubar__user", title: t("ui.account") do %>
          <span class="menubar__user-name"><%= current_user.display_name %></span>
          <%= role_icon(current_user) %>
        <% end %>
        <%= button_to t("ui.logout"), destroy_user_session_path, method: :delete, class: "menubar__button",
                      form_class: "button_to menubar__logout" %>
      <% end %>
    </div>
  </header>

  <% if impersonator && user_signed_in? %>
    <div class="impersonation-banner" role="status">
      <span><%= t("ui.impersonation.banner", name: current_user.display_name, role: role_label(current_user)) %></span>
      <%= button_to t("ui.impersonation.back"), impersonation_path, method: :delete, class: "btn btn--small", data: { turbo: false } %>
    </div>
  <% end %>
  <main class="desk" id="main">
    <% if flash.any? %>
      <div class="flash-stack">
        <% flash.each do |type, message| %>
          <%= render "partials/flash", type: type, message: message if message.is_a?(String) %>
        <% end %>
      </div>
    <% end %>

    <%# The own account page is a grid of panels (ui.md "Own account page"). %>
    <% if devise_controller? && !content_for?(:wide_page) %>
      <div class="sticky sticky--yellow auth">
        <div class="sticky__bar"><span class="sticky__caption">Stopan</span></div>
        <div class="auth__body"><%= yield %></div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </main>
  <% if user_signed_in? %>
    <% unless without_organization? %>
      <%= turbo_stream_from current_user, :notifications, channel: NotificationsChannel %>
      <%# Every signed-in page counts as online (specs/presence.md). %>
      <%= turbo_stream_from(*Presence.stream(current_user), channel: PresenceChannel, data: { ticket: content_for(:presence_ticket).presence }) %>
    <% end %>
    <% if live_admin_page? %><%= turbo_stream_from :admin, channel: AdminChannel %><% end %>
    <%= render "partials/confirm_dialog" %>
  <% end %>
  <%= render "partials/preview_dialog" unless devise_controller? %>
</body>
</html>
