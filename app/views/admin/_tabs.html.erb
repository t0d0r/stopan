<nav class="tabs admin-tabs" aria-label="<%= t("ui.admin.sections") %>">
  <%# Organization administrators: their organizations, users and deleted tickets (specs/org-admins.md). %>
  <% if current_user.admin? %>
    <%= link_to t("ui.admin.overview"), admin_root_path, class: "tab", aria: { current: ("page" if controller_name == "dashboard") } %>
  <% end %>
  <%= link_to t("ui.admin.users"), admin_users_path, class: "tab", aria: { current: ("page" if controller_name == "users") } %>
  <%= link_to t("ui.admin.organizations"), admin_organizations_path, class: "tab",
              aria: { current: ("page" if controller_name.in?(%w[organizations memberships])) } %>
  <%= link_to t("ui.admin.deleted.title"), admin_deleted_tickets_path, class: "tab", aria: { current: ("page" if controller_name == "deleted_tickets") } %>
  <% if current_user.admin? %>
    <%= link_to t("ui.admin.settings.title"), admin_settings_path, class: "tab", aria: { current: ("page" if controller_name == "settings") } %>
  <% end %>
</nav>
