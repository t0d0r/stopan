<%# What holds for all mail of the organization: the intro and the
    language of emails to requesters (specs/organization-mail.md). Locals: f, organization. %>
<div class="mail-settings" id="mail-settings">
  <h2 class="section-title"><%= t("ui.admin.mail.title") %></h2>
  <p class="field-hint"><%= t("ui.admin.mail.intro") %></p>
  <div class="field">
    <%= f.label :mail_locale, t("ui.admin.mail.locale") %>
    <%= f.select :mail_locale, [ [ t("ui.admin.mail.locale_recipient"), "" ] ] + ApplicationHelper::LANGUAGE_NAMES.invert.to_a,
                 {}, class: "select", aria: { describedby: "mail-locale-hint" } %>
    <p class="field-hint" id="mail-locale-hint"><%= t("ui.admin.mail.locale_hint") %></p>
  </div>
  <% if organization.google_mail? && organization.mail_connection %>
    <p class="callout"><%= t("ui.admin.mail.google_fields", email: organization.mail_connection.email) %></p>
  <% end %>
</div>
