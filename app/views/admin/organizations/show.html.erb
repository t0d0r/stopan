<% content_for :title, @organization.name %>
<div class="desk__header">
  <h1 class="desk__title"><%= @organization.name %></h1>
  <%= render "admin/tabs" %>
</div>

<div class="two-columns two-columns--org">
  <section class="sticky sticky--gray panel" aria-labelledby="members-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.admin.members") %></span></header>
    <div class="panel__body">
      <h2 class="section-title" id="members-title"><%= t("ui.admin.members_count", count: @memberships.size) %></h2>
      <% if @memberships.any? %>
        <div class="table-scroll">
          <table class="ledger table-members">
            <tbody>
              <% @memberships.each do |membership| %>
                <tr id="<%= dom_id(membership) %>">
                  <td class="text"><%= link_to membership.user.display_name, edit_admin_user_path(membership.user) %></td>
                  <td class="text"><%= membership.user.email %></td>
                  <td><span class="role-pill role-pill--<%= membership.user.role %>"><%= role_label(membership.user) %></span></td>
                  <td class="action">
                    <%= button_to t("ui.admin.remove"), admin_membership_path(membership), method: :delete, class: "link-button",
                                  form: { data: confirm_data(
                                    title: t("ui.confirm.remove_member_title", name: membership.user.display_name),
                                    body: t("ui.confirm.remove_member", name: membership.user.display_name, organization: @organization.name),
                                    button: t("ui.admin.remove")) } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="panel__empty"><%= t("ui.admin.no_members") %></p>
      <% end %>
      <% if @candidates.any? %>
        <%= render "admin/organizations/member_picker", organization: @organization, candidates: @candidates %>
      <% end %>
      <div class="form-actions form-actions--start">
        <%= link_to t("ui.admin.messages.to_members"),
                    new_admin_message_path(organization_id: @organization.id, return_to: admin_organization_path(@organization)), class: "btn" %>
      </div>
    </div>
  </section>

  <section class="sticky sticky--purple panel org-details" aria-labelledby="org-details-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.admin.details") %></span></header>
    <div class="panel__body">
      <h2 class="sr-only" id="org-details-title"><%= t("ui.admin.details") %></h2>
      <%# Ticket counts as two tiles, then the date (specs/ui.md "Admin"). %>
      <div class="org-stats">
        <%= link_to tickets_path(view: "unsolved", organization: @organization.id), class: "org-stat" do %>
          <strong class="org-stat__value"><%= @unsolved_count %></strong><span class="org-stat__label"><%= t("ui.admin.unsolved") %></span>
        <% end %>
        <%= link_to tickets_path(view: "all", organization: @organization.id), class: "org-stat" do %>
          <strong class="org-stat__value"><%= @ticket_count %></strong><span class="org-stat__label"><%= t("ui.admin.all_tickets") %></span>
        <% end %>
      </div>
      <p class="org-details__since"><%= t("ui.fields.created") %> <%= time_ago @organization.created_at %></p>
      <% if @organization.notes.present? %>
        <h3 class="section-title"><%= t("ui.fields.notes") %></h3>
        <div class="ticket-text org-details__notes"><%= ticket_text @organization.notes %></div>
      <% end %>
      <%= render "admin/organizations/mail_status", organization: @organization %>
      <div class="form-actions form-actions--start org-details__actions">
        <%= link_to t("ui.admin.edit"), edit_admin_organization_path(@organization), class: "btn btn--primary" %>
        <% if @ticket_count.zero? %>
          <%= button_to t("ui.delete"), admin_organization_path(@organization), method: :delete, class: "btn btn--danger",
                        form: { data: confirm_data(title: t("ui.confirm.delete_organization_title", name: @organization.name),
                                                   body: t("ui.confirm.delete_organization", count: @memberships.size),
                                                   button: t("ui.confirm.delete_organization_button")) } %>
        <% end %>
      </div>
    </div>
  </section>
</div>

<%# Remove all tickets for good after typing the name; settings stay
    (specs/admin.md "Flush all tickets of an organization"). %>
<% if @ticket_count.positive? %>
  <section class="sticky sticky--pink panel danger-zone" id="danger-zone" aria-labelledby="danger-zone-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.admin.flush.caption") %></span></header>
    <div class="panel__body">
      <h2 class="section-title" id="danger-zone-title"><%= t("ui.admin.flush.title") %></h2>
      <p><%= t("ui.admin.flush.body", count: @ticket_count) %></p>
      <p class="field-hint"><%= t("ui.admin.flush.kept") %></p>
      <%= form_with url: flush_admin_organization_path(@organization), method: :post, class: "stack-form danger-zone__form",
                    data: { turbo: false } do %>
        <div class="field">
          <%= label_tag :confirm_name do %><%= t("ui.admin.flush.type_name") %> <strong><%= @organization.name %></strong><% end %>
          <%= text_field_tag :confirm_name, nil, class: "field-input", autocomplete: "off", spellcheck: false, required: true,
                             data: { flush_name: @organization.name } %>
        </div>
        <div class="form-actions form-actions--start">
          <%= submit_tag t("ui.admin.flush.button", count: @ticket_count), name: nil, class: "btn btn--destructive", data: { flush_button: true } %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
