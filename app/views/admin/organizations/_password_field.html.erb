<%# Write-only password: never shows the stored value; blank keeps it.
    Locals: f, organization, attribute. %>
<% stored = organization.persisted? && organization.public_send("#{attribute}_in_database").present? %>
<div class="field">
  <%= f.label attribute %>
  <%= f.password_field attribute, value: nil, class: "field-input", autocomplete: "new-password",
                       aria: { describedby: "#{attribute}-hint" } %>
  <small class="field-hint" id="<%= attribute %>-hint">
    <%= stored ? t("ui.admin.mail.password_stored") : t("ui.admin.mail.password_none") %>
  </small>
  <% if stored %>
    <label class="check-field"><%= f.check_box "remove_#{attribute}" %> <%= t("ui.admin.mail.password_remove") %></label>
  <% end %>
</div>
