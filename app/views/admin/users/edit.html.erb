<% content_for :title, t("ui.admin.edit_user", name: @user.display_name) %>
<section class="sticky sticky--gray panel panel--form" aria-labelledby="user-form-title">
  <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.admin.users") %></span></header>
  <div class="panel__body">
    <h1 class="panel__title" id="user-form-title"><%= t("ui.admin.edit_user", name: @user.name_was.presence || @user.username_was.presence || @user.email_was) %></h1>
    <%= render "form", user: @user %>
  </div>
</section>
<%# Impersonation and its record are for super administrators (specs/org-admins.md). %>
<%= render "admin/users/impersonation", user: @user if current_user.admin? %>
