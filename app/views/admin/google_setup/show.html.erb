<% content_for :title, t("ui.google_setup.title") %>
<div class="desk__header">
  <h1 class="desk__title"><%= t("ui.google_setup.title") %></h1>
  <%= render "admin/tabs" %>
</div>

<%# The Google setup wizard (specs/mail-oauth.md "Setup wizard"). %>
<ol class="wizard-steps" aria-label="<%= t("ui.google_setup.progress") %>">
  <% current = @steps.index(@step) %>
  <% @steps.each_with_index do |step, index| %>
    <li class="wizard-steps__item<%= " is-done" if index < current %>" <%= "aria-current=step" if index == current %>>
      <span class="wizard-steps__number" aria-hidden="true"><%= index < current ? icon(:check, size: 12) : index + 1 %></span>
      <span class="wizard-steps__label"><%= t("ui.google_setup.steps.#{step}") %></span>
    </li>
  <% end %>
</ol>

<section class="sticky sticky--green panel wizard" aria-labelledby="wizard-title">
  <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.google_setup.step_of", step: current + 1, count: @steps.size) %></span></header>
  <div class="panel__body">
    <h2 class="wizard__title" id="wizard-title"><%= t("ui.google_setup.steps.#{@step}") %></h2>
    <%= render Admin::GoogleSetupController::STEP_PARTIALS.fetch(@step) %>
  </div>
</section>
