<ol class="wizard-list">
  <li>
    <p><%= t("ui.google_setup.project.project") %></p>
    <%= render "admin/google_setup/external", url: "https://console.cloud.google.com/projectcreate", label: t("ui.google_setup.project.open_project") %>
  </li>
  <li>
    <p><%= t("ui.google_setup.project.branding") %></p>
    <%= render "admin/google_setup/external", url: "https://console.cloud.google.com/auth/branding", label: t("ui.google_setup.project.open_branding") %>
    <%= render "admin/google_setup/copy_field", id: "wizard-app-name", label: t("ui.google_setup.project.app_name"), value: "Stopan" %>
    <%= render "admin/google_setup/copy_field", id: "wizard-support-email", label: t("ui.google_setup.project.support_email"), value: current_user.email %>
  </li>
  <li>
    <% if @kind == "workspace" %>
      <p><%= t("ui.google_setup.project.audience_internal") %></p>
    <% else %>
      <p><%= t("ui.google_setup.project.audience_external") %></p>
      <%= render "admin/google_setup/external", url: "https://console.cloud.google.com/auth/audience", label: t("ui.google_setup.project.open_audience") %>
      <p class="callout"><%= t("ui.google_setup.project.testing_note") %></p>
    <% end %>
  </li>
</ol>
<%= render "admin/google_setup/nav", back: "account", next_step: "access" %>
