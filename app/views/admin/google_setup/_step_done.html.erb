<% connected = @organizations.select(&:mail_connection) %>
<% if connected.any? %>
  <p><%= t("ui.google_setup.done.done") %></p>
  <ul class="share-list">
    <% connected.each do |organization| %>
      <li class="share-list__item">
        <p class="share-list__title"><strong><%= organization.name %></strong></p>
        <p class="share-list__meta"><%= t("ui.admin.mail.google_as", email: organization.mail_connection.email) %></p>
        <%= link_to t("ui.google_setup.done.test"), admin_organization_path(organization, anchor: "mail"), class: "btn" %>
      </li>
    <% end %>
  </ul>
  <p class="field-hint"><%= t("ui.google_setup.done.test_hint") %></p>
<% else %>
  <p><%= t("ui.google_setup.done.none") %></p>
<% end %>
<%= render "admin/google_setup/nav", back: "connect" %>
