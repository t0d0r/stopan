<ol class="wizard-list">
  <li>
    <p><%= t("ui.google_setup.access.open") %></p>
    <%= render "admin/google_setup/external", url: "https://console.cloud.google.com/auth/scopes", label: t("ui.google_setup.access.open_scopes") %>
  </li>
  <li>
    <p><%= t("ui.google_setup.access.add") %></p>
    <%= render "admin/google_setup/copy_field", id: "wizard-scope", label: t("ui.google_setup.access.scope"), value: "https://mail.google.com/" %>
    <p class="field-hint"><%= t("ui.google_setup.access.why") %></p>
  </li>
</ol>
<%= render "admin/google_setup/nav", back: "project", next_step: "client" %>
