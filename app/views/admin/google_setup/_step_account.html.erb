<p><%= t("ui.google_setup.account.intro") %></p>
<%= form_with url: admin_google_setup_path, method: :get, class: "stack-form" do %>
  <fieldset class="wizard-choice">
    <legend class="sr-only"><%= t("ui.google_setup.steps.account") %></legend>
    <% Admin::GoogleSetupController::KINDS.each do |kind| %>
      <label class="wizard-choice__option">
        <%= radio_button_tag :kind, kind, @kind == kind %>
        <span>
          <strong><%= t("ui.google_setup.account.#{kind}") %></strong>
          <span class="field-hint"><%= t("ui.google_setup.account.#{kind}_hint") %></span>
        </span>
      </label>
    <% end %>
  </fieldset>
  <div class="wizard__nav"><%= submit_tag t("ui.google_setup.next"), name: nil, class: "btn btn--primary" %></div>
<% end %>
