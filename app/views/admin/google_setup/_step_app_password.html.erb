<ol class="wizard-list">
  <li>
    <p><%= t("ui.google_setup.app_password.sign_in") %></p>
    <%= render "admin/google_setup/external", url: "https://myaccount.google.com/signinoptions/twosv", label: t("ui.google_setup.app_password.open_twosv") %>
  </li>
  <li>
    <p><%= t("ui.google_setup.app_password.create") %></p>
    <%= render "admin/google_setup/external", url: "https://myaccount.google.com/apppasswords", label: t("ui.google_setup.app_password.open_apppasswords") %>
    <%= render "admin/google_setup/copy_field", id: "wizard-app-password-name", label: t("ui.google_setup.app_password.name"), value: "Stopan" %>
    <p><%= t("ui.google_setup.app_password.shown_once") %></p>
  </li>
</ol>
<p class="callout"><%= t("ui.google_setup.app_password.unavailable") %></p>
<%= render "admin/google_setup/nav", back: "account", next_step: "mailbox" %>
