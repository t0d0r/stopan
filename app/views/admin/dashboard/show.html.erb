<% content_for :title, t("ui.admin.title") %>
<div class="desk__header">
  <h1 class="desk__title"><%= t("ui.admin.title") %></h1>
  <%= render "admin/tabs" %>
</div>

<div class="stats">
  <%= link_to tickets_path(view: "unsolved"), class: "sticky sticky--pink stat" do %>
    <span class="stat__value"><%= @stats[:unsolved] %></span><span class="stat__label"><%= t("ui.admin.stats.unsolved") %></span>
  <% end %>
  <%= link_to tickets_path(view: "unassigned"), class: "sticky sticky--yellow stat" do %>
    <span class="stat__value"><%= @stats[:unassigned] %></span><span class="stat__label"><%= t("ui.admin.stats.unassigned") %></span>
  <% end %>
  <div class="sticky sticky--green stat">
    <span class="stat__value"><%= @stats[:done_week] %></span><span class="stat__label"><%= t("ui.admin.stats.done_week") %></span>
  </div>
  <%= link_to admin_organizations_path, class: "sticky sticky--purple stat" do %>
    <span class="stat__value"><%= @stats[:organizations] %></span><span class="stat__label"><%= t("ui.admin.stats.organizations") %></span>
  <% end %>
  <%= link_to admin_users_path(role: "agent"), class: "sticky sticky--blue stat" do %>
    <span class="stat__value"><%= @stats[:staff] %></span><span class="stat__label"><%= t("ui.admin.stats.staff") %></span>
  <% end %>
  <%= link_to admin_users_path(role: "requester"), class: "sticky sticky--gray stat" do %>
    <span class="stat__value"><%= @stats[:requesters] %></span><span class="stat__label"><%= t("ui.admin.stats.requesters") %></span>
  <% end %>
</div>

<div class="two-columns">
  <section class="sticky sticky--gray panel" aria-labelledby="busiest-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.admin.organizations") %></span></header>
    <div class="panel__body">
      <h2 class="section-title" id="busiest-title"><%= t("ui.admin.busiest") %></h2>
      <% if @busiest.any? %>
        <table class="ledger">
          <tbody>
            <% @busiest.each do |organization| %>
              <tr>
                <td class="text"><%= link_to organization.name, admin_organization_path(organization) %></td>
                <td class="num"><%= link_to organization.unsolved_count, tickets_path(view: "unsolved", organization: organization.id) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="panel__empty"><%= t("ui.admin.no_unsolved") %></p>
      <% end %>
    </div>
  </section>

  <section class="sticky sticky--gray panel" aria-labelledby="recent-users-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= t("ui.admin.users") %></span></header>
    <div class="panel__body">
      <div class="panel__head">
        <h2 class="section-title" id="recent-users-title"><%= t("ui.admin.recent_users") %></h2>
        <%= link_to t("ui.admin.new_user"), new_admin_user_path, class: "btn btn--primary" %>
      </div>
      <table class="ledger">
        <tbody>
          <% @recent_users.each do |user| %>
            <tr>
              <td class="text"><%= link_to user.display_name, edit_admin_user_path(user) %></td>
              <td><span class="role-pill role-pill--<%= user.role %>"><%= role_label(user) %></span></td>
              <td class="date"><%= time_ago user.created_at %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<section class="sticky sticky--purple panel" aria-labelledby="shared-title">
  <header class="sticky__bar"><%= icon :link, size: 11 %><span class="sticky__caption"><%= t("ui.share.title") %></span></header>
  <div class="panel__body">
    <h2 class="section-title" id="shared-title"><%= t("ui.admin.shared_tickets", count: @shared_tickets.size) %></h2>
    <% if @shared_tickets.any? %>
      <div class="table-scroll">
        <table class="ledger table-shared">
          <tbody>
            <% @shared_tickets.each do |ticket| %>
              <tr id="<%= dom_id(ticket, :shared) %>">
                <td class="num ticket-number"><%= ticket.reference %></td>
                <td class="text"><%= link_to ticket.subject, ticket_path(ticket, anchor: "sharing") %></td>
                <td><%= ticket.share_password? ? t("ui.admin.share_password") : t("ui.admin.share_open") %></td>
                <td class="date"><%= time_ago ticket.shared_at %></td>
                <td class="action">
                  <%= button_to t("ui.share.stop"), ticket_share_path(ticket), method: :delete, class: "link-button btn--danger",
                                form: { data: confirm_data(title: t("ui.share.stop_title"), body: t("ui.share.stop_body"),
                                                           button: t("ui.share.stop")) } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="panel__empty"><%= t("ui.admin.no_shared_tickets") %></p>
    <% end %>
  </div>
</section>
