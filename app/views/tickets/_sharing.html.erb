<%# Share link of the ticket (specs/sharing.md). %>
<section class="sticky sticky--purple panel side-panel sharing" id="sharing" aria-labelledby="sharing-title">
  <header class="sticky__bar"><%= icon :link, size: 11 %><span class="sticky__caption"><%= t("ui.share.title") %></span></header>
  <div class="panel__body">
    <h2 class="sr-only" id="sharing-title"><%= t("ui.share.title") %></h2>
    <% if ticket.shared? %>
      <p class="sharing__status">
        <%= ticket.share_password? ? t("ui.share.status_password") : t("ui.share.status_open") %>
        <%= time_ago ticket.shared_at %>
      </p>
      <div class="sharing__link">
        <%= label_tag "share-url", t("ui.share.link"), class: "sr-only" %>
        <%= text_field_tag "share-url", shared_ticket_url(ticket.share_token), readonly: true, class: "field-input",
                           data: { select_on_focus: true } %>
        <button type="button" class="btn" data-copy="share-url" data-copied-label="<%= t("ui.share.copied") %>">
          <%= icon :copy, size: 12 %> <span data-copy-label><%= t("ui.share.copy") %></span>
        </button>
      </div>
      <%= button_to t("ui.share.stop"), ticket_share_path(ticket), method: :delete, class: "btn btn--danger btn--block",
                    form: { data: confirm_data(title: t("ui.share.stop_title"), body: t("ui.share.stop_body"),
                                               button: t("ui.share.stop")) } %>
      <details class="sharing__new">
        <summary><%= t("ui.share.new_link") %></summary>
        <%= render "tickets/share_form", ticket: ticket, submit: t("ui.share.replace") %>
      </details>
    <% else %>
      <p class="sharing__hint"><%= t("ui.share.hint") %></p>
      <%= render "tickets/share_form", ticket: ticket, submit: t("ui.share.create") %>
    <% end %>
  </div>
</section>
