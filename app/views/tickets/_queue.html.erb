<div class="desk__header">
  <h1 class="desk__title"><%= t("ui.queue.title") %></h1>
  <%= link_to new_ticket_path, class: "btn btn--primary" do %><%= icon :plus %> <%= t("ui.nav.new_ticket") %><% end %>
</div>

<div class="queue">
  <nav class="queue__views" aria-label="<%= t("ui.queue.views_label") %>">
    <ul>
      <% filter.views.each do |view| %>
        <li>
          <%= link_to tickets_path(view: view), class: "view-link", aria: { current: ("page" if view == filter.view) } do %>
            <span class="view-link__label"><%= queue_view_label(view) %></span>
            <span class="view-link__count"><%= filter.counts[view] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <section class="sticky sticky--gray panel queue__list" aria-labelledby="queue-list-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= queue_view_label(filter.view) %></span></header>
    <div class="panel__body">
      <h2 class="sr-only" id="queue-list-title"><%= queue_view_label(filter.view) %></h2>
      <%= form_with url: tickets_path, method: :get, class: "filters", data: { filter_form: true, turbo_action: "replace" } do %>
        <%= hidden_field_tag :view, filter.view %>
        <div class="filters__search search-field">
          <%= icon :search %>
          <%= label_tag :q, t("ui.queue.search_label"), class: "sr-only" %>
          <%= search_field_tag :q, filter.query, class: "search-field__input", placeholder: t("ui.queue.search_placeholder") %>
        </div>
        <div class="filters__field">
          <%= label_tag :status, t("ui.fields.status") %>
          <%= select_tag :status, options_for_select(Ticket::STATUSES.map { |s| [ status_name(s), s ] }, filter.status),
                         include_blank: t("ui.queue.any"), class: "select", data: { auto_submit: true } %>
        </div>
        <div class="filters__field">
          <%= label_tag :priority, t("ui.fields.priority") %>
          <%= select_tag :priority, options_for_select(priority_options, filter.priority),
                         include_blank: t("ui.queue.any"), class: "select", data: { auto_submit: true } %>
        </div>
        <div class="filters__field">
          <%= label_tag :assignee, t("ui.fields.assignee") %>
          <%= select_tag :assignee,
                         options_for_select([ [ t("ui.queue.assignee_me"), "me" ], [ t("ui.queue.assignee_none"), "none" ] ] +
                                            User.staff.active.ordered.map { |u| [ u.display_name, u.id.to_s ] }, filter.assignee),
                         include_blank: t("ui.queue.any"), class: "select", data: { auto_submit: true } %>
        </div>
        <div class="filters__field">
          <%= label_tag :organization, t("ui.fields.organization") %>
          <%= select_tag :organization, options_from_collection_for_select(Organization.ordered, :id, :name, filter.organization_id),
                         include_blank: t("ui.queue.any"), class: "select", data: { auto_submit: true } %>
        </div>
        <div class="filters__field">
          <%= label_tag :sort, t("ui.queue.sort") %>
          <%= select_tag :sort, options_for_select(TicketFilter::SORTS.map { |s| [ t("ui.queue.sorts.#{s}"), s ] }, filter.sort),
                         class: "select", data: { auto_submit: true } %>
        </div>
        <div class="filters__actions">
          <%= submit_tag t("ui.queue.apply"), class: "btn", name: nil %>
          <% if filter.filtered? %>
            <%= link_to t("ui.queue.clear"), tickets_path(view: filter.view), class: "filters__clear" %>
          <% end %>
        </div>
      <% end %>

      <% if filter.tickets.any? %>
        <div class="table-scroll">
          <table class="ledger tickets-table">
            <thead>
              <tr>
                <th scope="col" class="num"><%= t("ui.fields.number") %></th>
                <th scope="col"><%= t("ui.fields.subject") %></th>
                <th scope="col" class="col-org"><%= t("ui.fields.organization") %></th>
                <th scope="col"><%= t("ui.fields.status") %></th>
                <th scope="col" class="col-priority"><%= t("ui.fields.priority") %></th>
                <th scope="col" class="col-assignee"><%= t("ui.fields.assignee") %></th>
                <th scope="col" class="col-updated"><%= t("ui.fields.updated") %></th>
              </tr>
            </thead>
            <tbody>
              <% filter.tickets.each do |ticket| %>
                <tr id="<%= dom_id(ticket) %>" class="ticket-row ticket-row--<%= ticket.priority %>">
                  <td class="num ticket-number"><%= ticket.reference %></td>
                  <td class="text">
                    <%= link_to ticket.subject, ticket_path(ticket), class: "ticket-link" %>
                    <span class="ticket-row__requester"><%= ticket.requester.display_name %></span>
                  </td>
                  <td class="text col-org"><%= ticket.organization.name %></td>
                  <td><%= status_pill ticket.status %></td>
                  <td class="col-priority"><%= priority_pill ticket.priority %></td>
                  <td class="text col-assignee"><%= ticket.assignee&.display_name || tag.span(t("ui.unassigned"), class: "muted") %></td>
                  <td class="date col-updated"><%= time_ago ticket.updated_at %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "pagination", filter: filter %>
      <% else %>
        <p class="panel__empty"><%= filter.filtered? ? t("ui.queue.no_match") : t("ui.queue.empty") %></p>
      <% end %>
    </div>
  </section>
</div>
