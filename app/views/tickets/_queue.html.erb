<% staff = Ticket.assignable_staff_for(current_user).to_a %>
<%# Who each row's assign menu may offer: admins and the ticket organization's agents (roles.md). %>
<% agent_orgs = Membership.where(user_id: staff.reject(&:admin?).map(&:id)).pluck(:user_id, :organization_id).group_by(&:last).transform_values { |pairs| pairs.map(&:first) } %>
<div class="desk__header">
  <h1 class="desk__title"><%= t("ui.queue.title") %></h1>
  <%= render "tickets/view_switch", current: :list %>
  <%= link_to new_ticket_path, class: "btn btn--primary" do %><%= icon :plus %> <%= t("ui.nav.new_ticket") %><% end %>
</div>

<div class="queue">
  <nav class="queue__views" aria-label="<%= t("ui.queue.views_label") %>">
    <ul>
      <% filter.views.each do |view| %>
        <li>
          <%= link_to tickets_path(view: view), class: "view-link sticky--#{view_color(view)}",
                                                aria: { current: ("page" if view == filter.view) } do %>
            <span class="view-link__dot" aria-hidden="true"></span>
            <span class="view-link__label"><%= queue_view_label(view) %></span>
            <span class="view-link__count"><%= filter.counts[view] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <section class="sticky sticky--<%= view_color(filter.view) %> panel queue__list" aria-labelledby="queue-list-title">
    <header class="sticky__bar"><span class="sticky__caption"><%= queue_view_label(filter.view) %></span></header>
    <div class="panel__body">
      <h2 class="sr-only" id="queue-list-title"><%= queue_view_label(filter.view) %></h2>
      <%= render "tickets/filters", filter: filter, staff: staff, url: tickets_path, view: filter.view,
                                    clear_path: tickets_path(view: filter.view) %>

      <% if filter.tickets.any? %>
        <div class="table-scroll">
          <table class="ledger tickets-table">
            <thead>
              <tr>
                <th scope="col" class="num"><%= t("ui.fields.number") %></th>
                <th scope="col"><%= t("ui.fields.subject") %></th>
                <th scope="col" class="col-org"><%= t("ui.fields.organization") %></th>
                <th scope="col"><%= t("ui.fields.status") %></th>
                <th scope="col" class="col-priority"><%= t("ui.fields.priority") %></th>
                <th scope="col" class="col-assignee"><%= t("ui.fields.assignee") %></th>
                <th scope="col" class="col-updated"><%= t("ui.fields.updated") %></th>
              </tr>
            </thead>
            <tbody>
              <% filter.tickets.each do |ticket| %>
                <tr id="<%= dom_id(ticket) %>" class="ticket-row ticket-row--<%= ticket.priority %>">
                  <td class="num ticket-number"><%= ticket.reference %></td>
                  <td class="text">
                    <%= link_to ticket_path(ticket), class: "ticket-link" do %><%= ticket.subject %><% if ticket.shared? %> <%= icon :link, size: 12, label: t("ui.share.shared_by_link") %><% end %><% end %>
                    <span class="ticket-row__requester"><%= ticket.requester.display_name %></span>
                  </td>
                  <td class="text col-org"><%= ticket.organization.name %></td>
                  <td><%= status_pill ticket.status %><% if ticket.stage %> <span class="stage-tag">&middot; <%= ticket.stage.name %></span><% end %></td>
                  <td class="col-priority"><%= priority_pill ticket.priority %></td>
                  <td class="text col-assignee">
                    <div class="assignee">
                      <%= render "assign_menu", ticket: ticket,
                                 staff: staff.select { |user| user.admin? || agent_orgs.fetch(ticket.organization_id, []).include?(user.id) } %>
                      <%= render "take_button", ticket: ticket if ticket.assignee_id.nil? %>
                    </div>
                  </td>
                  <td class="date col-updated"><%= time_ago ticket.updated_at %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "pagination", filter: filter %>
      <% else %>
        <p class="panel__empty"><%= filter.filtered? ? t("ui.queue.no_match") : t("ui.queue.empty") %></p>
      <% end %>
    </div>
  </section>
</div>
