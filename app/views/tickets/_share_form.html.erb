<%= form_with url: ticket_share_path(ticket), method: :post, class: "stack-form share-form" do %>
  <div class="field">
    <%= label_tag "share_password_#{ticket.shared? ? 'new' : 'first'}", t("ui.share.password") %>
    <%= password_field_tag :share_password, nil, id: "share_password_#{ticket.shared? ? 'new' : 'first'}",
                           class: "field-input", autocomplete: "new-password",
                           minlength: Ticket::SHARE_PASSWORD_LENGTH.min, maxlength: Ticket::SHARE_PASSWORD_LENGTH.max %>
    <small class="field-hint"><%= t("ui.share.password_hint", min: Ticket::SHARE_PASSWORD_LENGTH.min) %></small>
  </div>
  <div class="field">
    <% expires_id = "share_expires_in_#{ticket.shared? ? 'new' : 'first'}" %>
    <%= label_tag expires_id, t("ui.share.expires") %>
    <%= select_tag :share_expires_in,
                   options_for_select([ [ t("ui.share.expires_never"), "" ] ] +
                                      Ticket::SHARE_EXPIRY_DAYS.map { |days| [ t("ui.share.expires_days", count: days), days ] }),
                   id: expires_id, class: "field-input" %>
  </div>
  <%= submit_tag submit, class: "btn btn--primary btn--block", name: nil %>
<% end %>
