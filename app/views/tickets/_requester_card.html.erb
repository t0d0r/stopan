<section class="sticky sticky--yellow panel side-panel" id="requester" aria-labelledby="requester-title" data-side-panel>
  <%= side_panel_bar t("ui.fields.requester"), "requester-body" %>
  <div class="panel__body" id="requester-body">
    <h2 class="sr-only" id="requester-title"><%= t("ui.fields.requester") %></h2>
    <dl class="facts">
      <dt><%= t("ui.fields.name") %></dt>
      <%# Staff open the requester's profile (specs/people.md). %>
      <dd><%= current_user.staff? ? link_to(ticket.requester.display_name, person_path(ticket.requester)) : ticket.requester.display_name %></dd>
      <% if current_user.staff? %>
        <dt><%= t("ui.fields.email") %></dt>
        <dd class="text"><%= copy_email ticket.requester.email %></dd>
      <% end %>
      <dt><%= t("ui.fields.organization") %></dt>
      <dd><%= ticket.organization.name %></dd>
      <% if current_user.staff? %>
        <dt><%= t("ui.fields.assignee") %></dt>
        <dd><%= ticket.assignee&.display_name || t("ui.unassigned") %></dd>
      <% end %>
    </dl>
  </div>
</section>
