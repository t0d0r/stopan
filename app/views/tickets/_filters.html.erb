<%# The staff filters of the queue, the board and the search page (specs/queues.md "Filters",
    "Search page", specs/board.md). search_page: true adds the text field and advanced search. %>
<% search_page = local_assigns[:search_page] %>
<%= form_with url: url, method: :get, class: class_names("filters", local_assigns[:form_class]), data: { filter_form: true, turbo_action: "replace" } do %>
  <%= hidden_field_tag :view, view, id: nil if view %>
  <%= hidden_field_tag :q, filter.query, id: nil if filter.query && !search_page %>
  <%= hidden_field_tag :requester, filter.requester_id, id: nil if filter.requester_id %>
  <% if search_page %>
    <div class="filters__field search-page__query">
      <%= label_tag :q, t("ui.search.query") %>
      <%= search_field_tag :q, filter.query, class: "field-input", autocomplete: "off", autofocus: filter.query.nil?,
                           placeholder: t("ui.queue.search_placeholder") %>
    </div>
  <% end %>
  <div class="filters__field">
    <%= label_tag :status, t("ui.fields.status") %>
    <%= select_tag :status, options_for_select(Ticket::STATUSES.map { |s| [ status_name(s), s ] }, filter.status),
                   include_blank: t("ui.queue.any"), class: class_names("select", "is-set": filter.status), data: { auto_submit: true } %>
  </div>
  <div class="filters__field">
    <%= label_tag :priority, t("ui.fields.priority") %>
    <%= select_tag :priority, options_for_select(priority_options, filter.priority),
                   include_blank: t("ui.queue.any"), class: class_names("select", "is-set": filter.priority), data: { auto_submit: true } %>
  </div>
  <div class="filters__field">
    <%= label_tag :assignee, t("ui.fields.assignee") %>
    <%= select_tag :assignee,
                   options_for_select([ [ t("ui.queue.assignee_me"), "me" ], [ t("ui.queue.assignee_none"), "none" ] ] +
                                      staff.map { |u| [ u.display_name, u.id.to_s ] }, filter.assignee),
                   include_blank: t("ui.queue.any"), class: class_names("select", "is-set": filter.assignee), data: { auto_submit: true } %>
  </div>
  <div class="filters__field">
    <%= label_tag :organization, t("ui.fields.organization") %>
    <%= select_tag :organization, options_from_collection_for_select(current_user.visible_organizations.ordered, :id, :name, filter.organization_id),
                   include_blank: t("ui.queue.any"), class: class_names("select", "is-set": filter.organization_id), data: { auto_submit: true } %>
  </div>
  <div class="filters__field">
    <%= label_tag :sort, t("ui.queue.sort") %>
    <%= select_tag :sort, options_for_select(TicketFilter::SORTS.map { |s| [ t("ui.queue.sorts.#{s}"), s ] }, filter.sort),
                   class: "select", data: { auto_submit: true } %>
  </div>
  <%# One requester's tickets, from their profile (specs/people.md "Queue filter"). %>
  <% if filter.requester %>
    <div class="filters__field filters__chip">
      <span class="chip"><%= t("ui.people.requester_chip", name: filter.requester.display_name) %>
        <%= link_to url + "?" + filter.params_with(requester: nil, page: nil).to_query, class: "chip__remove",
                    "aria-label": t("ui.people.remove_requester") do %>&times;<% end %></span>
    </div>
  <% end %>
  <div class="filters__actions">
    <noscript><%= submit_tag t("ui.queue.apply"), class: "btn", name: nil %></noscript>
    <% if filter.filtered? %>
      <%= link_to t("ui.queue.clear"), clear_path, class: "filters__clear" %>
    <% end %>
  </div>
  <% if search_page %>
    <%# Advanced search, only on the search page (specs/queues.md "Search page"): applied with its own button. %>
    <% advanced = filter.advanced %>
    <section class="advanced-search" aria-labelledby="advanced-search-title">
      <h2 class="section-title" id="advanced-search-title">
        <%= t("ui.search.advanced") %><% if advanced.any? %> <span class="tab__count"><%= advanced.size %></span><% end %>
      </h2>
      <div class="advanced-search__fields">
        <div class="filters__field advanced-search__wide">
          <%= label_tag :words, t("ui.search.words") %>
          <%= text_field_tag :words, advanced[:words], class: "field-input", autocomplete: "off", placeholder: t("ui.search.words_hint") %>
        </div>
        <div class="filters__field advanced-search__check">
          <label><%= check_box_tag :in_comments, "1", advanced[:in_comments].present?, id: "in_comments" %> <%= t("ui.search.in_comments") %></label>
        </div>
        <div class="filters__field">
          <%= label_tag :requester_q, t("ui.fields.requester") %>
          <%= text_field_tag :requester_q, advanced[:requester_q], class: "field-input", autocomplete: "off", placeholder: t("ui.search.requester_hint") %>
        </div>
        <fieldset class="filters__field advanced-search__dates">
          <legend><%= t("ui.fields.created") %></legend>
          <%= date_field_tag :created_from, advanced[:created_from], class: "field-input", "aria-label": t("ui.search.created_from") %>
          <span aria-hidden="true">-</span>
          <%= date_field_tag :created_to, advanced[:created_to], class: "field-input", "aria-label": t("ui.search.created_to") %>
        </fieldset>
        <fieldset class="filters__field advanced-search__dates">
          <legend><%= t("ui.fields.updated") %></legend>
          <%= date_field_tag :updated_from, advanced[:updated_from], class: "field-input", "aria-label": t("ui.search.updated_from") %>
          <span aria-hidden="true">-</span>
          <%= date_field_tag :updated_to, advanced[:updated_to], class: "field-input", "aria-label": t("ui.search.updated_to") %>
        </fieldset>
        <div class="filters__field">
          <%= label_tag :source, t("ui.search.source") %>
          <%= select_tag :source, options_for_select(Ticket::SOURCES.map { |source| [ t("ui.people.source.#{source}"), source ] }, advanced[:source]),
                         include_blank: t("ui.queue.any"), class: class_names("select", "is-set": advanced[:source]) %>
        </div>
        <div class="filters__field advanced-search__check">
          <label><%= check_box_tag :files, "1", advanced[:files].present?, id: "files" %> <%= t("ui.search.files") %></label>
        </div>
        <div class="filters__field advanced-search__go">
          <%= submit_tag t("ui.search.go"), name: nil, class: "btn btn--primary" %>
        </div>
      </div>
    </section>
  <% end %>
<% end %>
