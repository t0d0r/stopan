<% content_for :title, "#{@ticket.reference} #{@ticket.subject_was || @ticket.subject}" %>
<% staff = current_user.staff? %>
<% turbo_refreshes_with scroll: :preserve %>
<%= turbo_stream_from(*@ticket.page_stream(current_user), channel: TicketsChannel, data: { ticket: @ticket.number }) %>
<div class="ticket-page">
  <%# The request as one note: strip, "#1001 Subject", pills, text (ui.md). %>
  <article class="sticky sticky--yellow message message--description ticket-head" id="description"
         data-long-request data-more="<%= t("ui.ticket.show_whole") %>" data-less="<%= t("ui.ticket.collapse") %>">
    <% editable = policy.edit_description? %>
    <%= render "tickets/message_bar", record: @ticket, author: @ticket.requester, kind: t("ui.ticket.description"),
               icon_name: :note, frame: "description-text",
               edit_path: (edit_ticket_description_path(@ticket) if editable),
               markdown_path: (markdown_ticket_description_path(@ticket) if editable), width_box: true %>
    <div class="message__body">
      <% if staff && @ticket.mail_headers.present? %><%= render "tickets/mail_headers", ticket: @ticket %><% end %>
      <%= turbo_frame_tag "description-text" do %>
        <%= render "tickets/note_heading", ticket: @ticket, priority: staff %>
        <%= message_text @ticket, task_path: (task_ticket_description_path(@ticket) if editable) %>
      <% end %>
      <% if translation_offered? %><%= render "tickets/translation", message: @ticket, ticket: @ticket %><% end %>
      <% if policy.see_revisions? %><%= render "tickets/revisions", record: @ticket, ticket: @ticket %><% end %>
      <% if @ticket.files.attached? %>
        <ul class="file-list" aria-label="<%= t("ui.fields.files") %>">
          <% @ticket.files.each do |file| %>
            <li><%= attachment_link @ticket, file %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </article>

  <aside class="ticket-side" aria-label="<%= t("ui.ticket.details") %>">
    <%= render "tickets/properties", ticket: @ticket %>
    <%= render "tickets/requester_card", ticket: @ticket %>
    <% if policy.share? %><%= render "tickets/sharing", ticket: @ticket %><% end %>
  </aside>

  <div class="ticket-main">
    <p class="callout live-notice" data-live-notice hidden role="status"><%= t("ui.ticket.changed_elsewhere") %></p>
    <h2 class="section-heading" id="timeline-title"><%= t("ui.timeline.title") %></h2>
    <%# Newest first puts the composer above the timeline (timeline.md "Order of the timeline"). %>
    <% if newest_first? %><%= render "tickets/composer", ticket: @ticket, comment: @comment %><% end %>
    <ol class="timeline<%= " timeline--newest-first" if newest_first? %>" aria-labelledby="timeline-title">
      <% @events.each do |event| %>
        <%= render "tickets/event", event: event, ticket: @ticket %>
      <% end %>
    </ol>

    <% unless newest_first? %><%= render "tickets/composer", ticket: @ticket, comment: @comment %><% end %>
  </div>
</div>
