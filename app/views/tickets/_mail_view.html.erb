<%# The mail as HTML in a sealed frame, with tabs to the text (specs/organization-mail.md
    "HTML view"), for the request or a reply. Remote images load only after "Show images".
    Locals: ticket, record (the ticket or a comment), text_pane (id of the text's element),
    anchor (where "Show images" comes back to). %>
<% images = params[:mail_images] == "1" %>
<% comment = record if record.is_a?(Comment) %>
<% pane = comment ? dom_id(comment, :mail_html) : "mail-pane-html" %>
<div class="mail-view" data-mail-view data-text-pane="<%= text_pane %>">
  <div class="mail-view__tabs" role="tablist" aria-label="<%= t("ui.mail_view.tabs_label") %>" hidden data-mail-tabs>
    <button type="button" role="tab" class="mail-view__tab" aria-selected="true" aria-controls="<%= pane %>" data-mail-tab="html"><%= t("ui.mail_view.html") %></button>
    <button type="button" role="tab" class="mail-view__tab" aria-selected="false" aria-controls="<%= text_pane %>" data-mail-tab="text"><%= t("ui.mail_view.text") %></button>
  </div>
  <div class="mail-view__pane" id="<%= pane %>" role="tabpanel" data-mail-pane="html">
    <% if !images && MailHtml.remote_images?(record.mail_html) %>
      <p class="mail-view__images">
        <%= icon :eye, size: 12 %> <%= t("ui.mail_view.images_blocked") %>
        <%= link_to t("ui.mail_view.show_images"), ticket_path(ticket, mail_images: 1, anchor: anchor) %>
      </p>
    <% end %>
    <% source = comment ? ticket_comment_mail_path(ticket, comment, images: (1 if images)) : ticket_mail_path(ticket, images: (1 if images)) %>
    <iframe class="mail-frame" src="<%= source %>" title="<%= t("ui.mail_view.frame_title") %>"
            sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin" referrerpolicy="no-referrer" data-mail-frame></iframe>
  </div>
</div>
