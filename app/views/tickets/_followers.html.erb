<%# Staff followers and people in Cc (specs/followers.md "The panel"). Staff
    see and manage both; the requester and Cc see the Cc names only, and a
    person in Cc may leave. %>
<% staff = current_user.staff? %>
<% manage = staff && policy.update? %>
<% cc = ticket.cc_users.to_a %>
<%# The requester adds colleagues (specs/followers.md "The requester adds colleagues"). %>
<% candidates = policy.add_cc? ? ticket.cc_candidates.to_a : [] %>
<% if staff || cc.any? || candidates.any? %>
  <section class="sticky sticky--green panel side-panel followers" id="followers" aria-labelledby="followers-title" data-side-panel>
    <%= side_panel_bar t("ui.followers.title"), "followers-body", icon_name: :people %>
    <div class="panel__body" id="followers-body">
      <h2 class="sr-only" id="followers-title"><%= t("ui.followers.title") %></h2>
      <% if staff %>
        <% following = ticket.ticket_followers.includes(:user).select { |f| f.user.staff? }.sort_by { |f| f.user.display_name.downcase } %>
        <h3 class="section-title"><%= t("ui.followers.following") %></h3>
        <% if following.any? %>
          <ul class="followers__list">
            <% following.each do |follower| %>
              <li class="followers__item">
                <span><%= follower.user.display_name %></span>
                <% if manage %>
                  <%= button_to ticket_follower_path(ticket, follower), method: :delete, class: "link-button",
                                aria: { label: t("ui.followers.remove_label", name: follower.user.display_name) } do %>
                    <%= icon :close, size: 12 %> <%= t("ui.followers.remove") %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="field-hint"><%= t("ui.followers.nobody") %></p>
        <% end %>
        <% if manage %>
          <% mine = following.find { |f| f.user_id == current_user.id } %>
          <% if mine %>
            <%= button_to ticket_follower_path(ticket, mine), method: :delete, class: "btn btn--block" do %>
              <%= icon :eye_off %> <%= t("ui.followers.unfollow") %>
            <% end %>
          <% elsif ticket.assignable_staff.exists?(current_user.id) %>
            <%= button_to ticket_followers_path(ticket), params: { user_id: current_user.id }, class: "btn btn--block" do %>
              <%= icon :eye %> <%= t("ui.followers.follow") %>
            <% end %>
          <% end %>
          <% colleagues = ticket.assignable_staff.where.not(id: [ current_user.id, *following.map(&:user_id) ]).to_a %>
          <% if colleagues.any? %>
            <%= form_with url: ticket_followers_path(ticket), class: "followers__add input-group" do %>
              <%= label_tag "follower_user_id", t("ui.followers.add_colleague"), class: "sr-only" %>
              <%= select_tag :user_id, options_from_collection_for_select(colleagues, :id, :display_name), id: "follower_user_id",
                             include_blank: t("ui.followers.add_colleague"), class: "select", required: true %>
              <%= button_tag type: "submit", name: nil, class: "btn" do %><%= icon :user_plus %> <%= t("ui.followers.add") %><% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <h3 class="section-title"><%= t("ui.followers.cc") %></h3>
      <% if cc.any? %>
        <ul class="followers__list">
          <% cc.each do |user| %>
            <li class="followers__item">
              <span>
                <%= user.display_name %>
                <% if staff %><span class="muted followers__email"><%= user.email %></span><% end %>
              </span>
              <% follower = ticket.ticket_followers.find_by(user_id: user.id) %>
              <% if manage || policy.remove_cc?(follower) %>
                <%= button_to ticket_follower_path(ticket, follower), method: :delete, class: "link-button",
                              aria: { label: t("ui.followers.remove_cc_label", name: user.display_name) } do %>
                  <%= icon :close, size: 12 %> <%= t("ui.followers.remove") %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% elsif staff %>
        <p class="field-hint"><%= t("ui.followers.no_cc") %></p>
      <% end %>
      <% if candidates.any? %>
        <%= form_with url: ticket_followers_path(ticket), class: "followers__add input-group" do %>
          <%= label_tag "cc_user_id", t("ui.followers.add_cc_colleague"), class: "sr-only" %>
          <%= select_tag :user_id, options_from_collection_for_select(candidates, :id, :display_name), id: "cc_user_id",
                         include_blank: t("ui.followers.pick_colleague"), class: "select", required: true %>
          <%= button_tag type: "submit", name: nil, class: "btn" do %><%= icon :user_plus %> <%= t("ui.followers.add") %><% end %>
        <% end %>
      <% end %>
      <%# A person in Cc leaves (specs/followers.md "Leaving"). %>
      <% mine_cc = ticket.ticket_followers.find_by(user_id: current_user.id) unless staff %>
      <% if mine_cc %>
        <%= button_to ticket_follower_path(ticket, mine_cc), method: :delete, class: "btn btn--block",
                      form: { data: confirm_data(title: t("ui.followers.leave_title"), body: t("ui.followers.leave_body"),
                                                 button: t("ui.followers.leave_cc")) } do %>
          <%= icon :eye_off %> <%= t("ui.followers.leave_cc") %>
        <% end %>
      <% end %>
      <% if manage %>
        <%= form_with url: ticket_followers_path(ticket), class: "followers__add input-group" do %>
          <%= label_tag "cc_email", t("ui.followers.add_cc"), class: "sr-only" %>
          <%= input_icon :envelope do %>
            <%= email_field_tag :email, nil, id: "cc_email", class: "field-input", placeholder: t("ui.followers.add_cc"),
                                autocomplete: "off", required: true %>
          <% end %>
          <%= button_tag type: "submit", name: nil, class: "btn" do %><%= icon :user_plus %> <%= t("ui.followers.add") %><% end %>
        <% end %>
        <% suggestions = ticket.cc_suggestions %>
        <% if suggestions.any? %>
          <p class="field-hint followers__hint"><%= t("ui.followers.suggestions") %></p>
          <ul class="followers__list">
            <% suggestions.each do |address| %>
              <li class="followers__item">
                <span class="followers__email"><%= address %></span>
                <%= button_to ticket_followers_path(ticket), params: { email: address }, class: "link-button followers__suggest",
                              aria: { label: t("ui.followers.add_to_cc_label", email: address) } do %>
                  <%= icon :user_plus, size: 12 %> <%= t("ui.followers.add_to_cc") %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
