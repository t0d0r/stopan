<% staff = current_user.staff? %>
<% if policy.comment? %>
  <% internal = comment.internal? %>
  <%# On phones it opens from the Reply bar, or open with errors (ui.md "Ticket page on phones"). %>
  <section class="sticky sticky--<%= internal ? "pink" : (staff ? "blue" : "yellow") %> composer<%= " is-internal" if internal %><%= " is-open" if comment.errors.any? %>"
           id="composer" aria-labelledby="composer-title" data-composer data-staff-color="blue">
    <header class="sticky__bar">
      <button type="button" class="sticky__box composer__close" aria-label="<%= t("ui.composer.close") %>" data-reply-close>&times;</button>
      <span class="sticky__caption" id="composer-title"><%= t("ui.composer.title") %></span>
    </header>
    <%= form_with model: comment, url: ticket_comments_path(ticket), class: "composer__form", data: { turbo: false } do |f| %>
      <%= form_errors comment %>
      <% if staff %>
        <fieldset class="composer__mode">
          <legend class="sr-only"><%= t("ui.composer.mode") %></legend>
          <% if policy.reply? %>
            <label class="mode-option">
              <%= f.radio_button :internal, "0", checked: !internal, data: { composer_mode: "public" } %>
              <%= icon :reply %> <%= t("ui.composer.public") %>
            </label>
          <% end %>
          <label class="mode-option mode-option--internal">
            <%= f.radio_button :internal, "1", checked: internal, data: { composer_mode: "internal" } %>
            <%= icon :lock %> <%= t("ui.composer.internal") %>
          </label>
        </fieldset>
      <% end %>
      <% if !staff && ticket.done? %>
        <p class="field-hint composer__reopen"><%= t("ui.composer.done") %></p>
      <% end %>
      <div class="field">
        <%= f.label :body, staff ? t("ui.composer.body_staff") : t("ui.composer.body"), class: "sr-only" %>
        <%= f.text_area :body, rows: 5, class: "field-input composer__body", required: true, maxlength: 20_000,
                        placeholder: staff ? t("ui.composer.placeholder_staff") : t("ui.composer.placeholder"),
                        data: { autogrow: true }, aria: { invalid: comment.errors[:body].any? } %>
      </div>
      <%= render "partials/markdown_check", f: f %>
      <p class="composer__hint composer__hint--internal"><%= icon :lock %> <%= t("ui.composer.internal_hint") %></p>
      <%# Emails to the requester: a toggle that saves at once, and what it means;
          hidden for an internal note (specs/notifications.md "Emails to the requester"). %>
      <% if staff && policy.reply? && policy.update? && ticket.requester %>
        <div class="composer__mail<%= " is-off" unless ticket.email_requester? %>" data-requester-mail
             data-path="<%= ticket_requester_mail_path(ticket) %>">
          <%= hidden_field_tag :email_requester, "0", id: nil %>
          <label class="toggle">
            <%= check_box_tag :email_requester, "1", ticket.email_requester?, role: "switch", class: "toggle__input",
                              data: { requester_mail_toggle: true }, aria: { describedby: "requester-mail-hint" } %>
            <span class="toggle__track" aria-hidden="true"></span>
            <span class="toggle__label"><%= t("ui.composer.email_requester") %></span>
          </label>
          <p class="composer__mail-hint" id="requester-mail-hint" aria-live="polite">
            <span class="composer__mail-on"><%= icon :envelope, size: 13 %> <%= t("ui.composer.email_on", email: ticket.customer_emails.to_sentence) %></span>
            <span class="composer__mail-off"><%= icon :lock, size: 13 %> <%= t("ui.composer.email_off") %></span>
          </p>
        </div>
      <% end %>
      <div class="composer__row">
        <div class="field composer__files">
          <%= f.label :files, t("ui.fields.files"), class: "sr-only" %>
          <%= render "partials/file_drop", f: f, hint_id: "composer-files-hint" %>
        </div>
        <%# The status select sits above the button (timeline.md "Composer"). %>
        <div class="composer__send">
        <% if staff %>
          <div class="field composer__status">
            <%= label_tag "comment_status", t("ui.composer.submit_as") %>
            <%= select_tag "comment[status]",
                           options_for_select([ [ t("ui.composer.keep_status", status: status_name(ticket.status_was || ticket.status)), "" ] ] +
                                              ticket.next_statuses.map { |s| [ status_name(s), s ] }, params.dig(:comment, :status)),
                           id: "comment_status", class: "select" %>
          </div>
        <% end %>
        <div class="composer__submit">
          <button type="submit" class="btn btn--primary" data-composer-submit
                  data-public-label="<%= t("ui.composer.send_reply") %>" data-internal-label="<%= t("ui.composer.add_note") %>">
            <%# The icon follows the mode, like the label (ui.md "Icons"). %>
            <span data-composer-icon="public"<%= " hidden" if internal %>><%= icon :send %></span>
            <span data-composer-icon="internal"<%= " hidden" unless internal %>><%= icon :lock %></span>
            <span data-composer-label><%= internal ? t("ui.composer.add_note") : t("ui.composer.send_reply") %></span>
          </button>
        </div>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
