# syntax=docker/dockerfile:1

# Development image: Ruby, build tools and SQLite, but no application code.
# compose.dev.yaml mounts the source tree into /rails, so code, view and CSS
# changes apply on the next page load without a rebuild or restart
# (make docker-dev, specs/docker.md). Not for production; see Dockerfile.

# Make sure RUBY_VERSION matches the Ruby version in .ruby-version
ARG RUBY_VERSION=4.0.7
FROM docker.io/library/ruby:$RUBY_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential curl git libyaml-dev pkg-config sqlite3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Non-root user; the volumes for gems, storage and tmp start out owned by it.
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash && \
    mkdir -p /rails/storage /rails/tmp && \
    chown -R rails:rails /rails /usr/local/bundle

# Gems live in a volume, not in the host's vendor/bundle (macOS builds).
# BUNDLE_APP_CONFIG keeps bundler away from the host's .bundle/config;
# BUNDLE_FROZEN keeps it from rewriting the mounted Gemfile.lock (the host
# owns it: make deps, then make docker-dev-restart).
ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_APP_CONFIG="/usr/local/bundle" \
    BUNDLE_FROZEN="true"

USER 1000:1000
WORKDIR /rails

# Install gems when the Gemfile changed, create, migrate and seed the
# database, add the demo data when DEMO_PASSWORD is set (stopan:demo does
# nothing if it exists), then start Puma on all interfaces of the container.
EXPOSE 3000
CMD ["sh", "-c", "bundle check >/dev/null || bundle install && bin/rails db:prepare && { [ -z \"$DEMO_PASSWORD\" ] || bin/rails stopan:demo; } && exec bin/rails server -b 0.0.0.0 -p 3000"]
