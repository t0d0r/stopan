{
  "client_id": 1,
  "params": {
    "server_id": 1,
    "ip_address": "*",
    "domain": "stopan.linuxfan.org",
    "type": "vhost",
    "parent_domain_id": 0,
    "vhost_type": "name",
    "hd_quota": -1,
    "traffic_quota": -1,
    "cgi": "n",
    "ssi": "n",
    "suexec": "y",
    "errordocs": 1,
    "subdomain": "none",
    "php": "no",
    "ruby": "n",
    "python": "n",
    "perl": "n",
    "ssl": "y",
    "ssl_letsencrypt": "y",
    "rewrite_to_https": "y",
    "stats_type": "awstats",
    "allow_override": "All",
    "pm": "dynamic",
    "log_retention": 30,
    "http_port": 80,
    "https_port": 443,
    "backup_interval": "none",
    "backup_copies": 1,
    "enable_pagespeed": "n",
    "active": "y",
    "apache_directives": "<IfModule pagespeed_module>\n\tModPagespeed off\n</IfModule>\nProxyRequests Off\nProxyPreserveHost On\nProxyTimeout 60\nRequestHeader set X-Forwarded-Proto \"https\"\nProxyPass /.well-known/acme-challenge/ !\nProxyPass / http://127.0.0.1:3183/ retry=0 upgrade=websocket\nProxyPassReverse / http://127.0.0.1:3183/\n",
    "pm_process_idle_timeout": 10,
    "pm_max_requests": 0
  }
}
