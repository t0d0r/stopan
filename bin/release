#!/bin/bash -e

# Releases (specs/release.md).
#
#   bin/release 0.2.0           tag main as v0.2.0 with a signed tag, push
#                               it, and publish the GitHub release with the
#                               files its release build made, once they are
#                               checked and signed (make release)
#   bin/release --files 0.1.0   run the release build again for the
#                               existing tag v0.1.0, then check, sign and
#                               attach its files, or create the release
#                               when there is none yet (make release-files)

mode=release
if [ "$1" = --files ]; then
  mode=files
  shift
fi
version=${1:-$VERSION}
fail() { echo "$*" >&2; exit 1; }

[ -n "$version" ] || fail "VERSION is missing: make release VERSION=0.1.0"
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  fail "VERSION must be three numbers without a leading v, for example 0.1.0 (got $version)"
tag=v$version
notes=tmp/release-notes-$tag.md
workflow=release.yml
# The reusable workflow that builds and signs the provenance (SLSA Build
# Level 3): the provenance must be signed in its name.
builder=release-build.yml

command -v gh >/dev/null && gh auth status >/dev/null 2>&1 || fail "gh is missing or not signed in (gh auth login)"
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) || fail "gh cannot read the GitHub repository"

# Signing (specs/release.md "Signed tags").
signers="$PWD/.github/allowed_signers"
setup='see specs/release.md "Signed tags"'
[ "$(git config --get gpg.format)" = ssh ] || fail "tags are signed with SSH: git config gpg.format ssh ($setup)"
key=$(git config --get user.signingkey) || fail "no signing key: git config user.signingkey <public key file> ($setup)"
key=${key/#\~/$HOME}
[ -f "$key" ] || fail "the signing key file $key does not exist ($setup)"
blob=$(awk '{print $2}' "$key")
[ -n "$blob" ] && [ -f "$signers" ] && grep -qF "$blob" "$signers" ||
  fail "the signing key is not in .github/allowed_signers ($setup)"
ssh-add -L 2>/dev/null | grep -qF "$blob" ||
  fail "ssh-agent does not hold the signing key: ssh-add --apple-use-keychain <private key> ($setup)"

# The functions below return on failure at each step, since -e does not
# apply inside a function called with ||.

# The release notes from the previous tag to this one.
write_notes() {
  local previous
  previous=$(git describe --tags --abbrev=0 "$tag^") || return 1
  mkdir -p tmp || return 1
  RELEASE_VERSION=$version bin/release-notes "$previous" "$tag" > "$notes"
}

# The id of the newest release build run of the tag for an event, 0 when
# there is none.
newest_run() {
  gh run list --workflow "$workflow" --event "$1" --limit 100 --json databaseId,displayTitle \
    --jq "[.[] | select(.displayTitle == \"Release build $tag\") | .databaseId] | max // 0"
}

# Waits up to two minutes for a run of event $1 newer than run $2, and
# prints its id.
wait_for_new_run() {
  local id
  for _ in $(seq 30); do
    id=$(newest_run "$1") || return 1
    [ "$id" -gt "$2" ] && { echo "$id"; return 0; }
    sleep 4
  done
  return 1
}

# The release files of build run $1 (specs/release.md "Signed release
# files"): waits for the run, downloads the archive and its provenance,
# checks both, then signs the archive. Prints the three paths.
release_files() {
  local run=$1 dir=tmp/release/$tag archive info event branch sha source_ref principal
  archive=$dir/stopan-$version.tar.gz
  echo "waiting for the release build $(gh run view "$run" --json url --jq .url)" >&2
  gh run watch "$run" --exit-status --interval 10 >&2 || return 1

  info=$(gh run view "$run" --json event,headBranch,headSha --jq '[.event, .headBranch, .headSha] | join(" ")') || return 1
  read -r event branch sha <<<"$info"
  git fetch -q origin main --tags || return 1
  case $event in
    push)
      source_ref=refs/tags/$tag
      [ "$branch" = "$tag" ] && [ "$sha" = "$(git rev-parse "$tag^{commit}")" ] ||
        { echo "run $run did not build the commit of $tag" >&2; return 1; } ;;
    workflow_dispatch)
      source_ref=refs/heads/main
      [ "$branch" = main ] && git merge-base --is-ancestor "$sha" origin/main ||
        { echo "run $run did not run from main" >&2; return 1; } ;;
    *)
      echo "run $run was started by $event" >&2; return 1 ;;
  esac

  rm -rf "$dir" && mkdir -p "$dir" || return 1
  gh run download "$run" --name release-archive --dir "$dir" || return 1
  gh run download "$run" --name release-provenance --dir "$dir" || return 1
  [ "$(ls "$dir")" = "$(printf '%s\n' "${archive##*/}" "${archive##*/}.intoto.jsonl")" ] ||
    { echo "run $run made other files than the archive and its provenance: $(cd "$dir" && echo *)" >&2; return 1; }

  gh attestation verify "$archive" --bundle "$archive.intoto.jsonl" --repo "$repo" \
    --signer-workflow "$repo/.github/workflows/$builder" --source-ref "$source_ref" --source-digest "$sha" \
    --deny-self-hosted-runners >&2 || return 1
  gzip -dc "$archive" | cmp -s - <(git -c tar.umask=0002 archive --format=tar --prefix="stopan-$version/" "$tag") ||
    { echo "the archive of run $run is not git archive of $tag" >&2; return 1; }

  ssh-keygen -q -Y sign -f "$key" -n file "$archive" >&2 || return 1
  principal=$(ssh-keygen -Y find-principals -f "$signers" -s "$archive.sig") || return 1
  ssh-keygen -Y verify -f "$signers" -I "$principal" -n file -s "$archive.sig" < "$archive" >&2 || return 1
  echo "$archive" "$archive.sig" "$archive.intoto.jsonl"
}

if [ "$mode" = files ]; then
  git fetch -q origin main --tags
  git rev-parse -q --verify "refs/tags/$tag" >/dev/null || fail "tag $tag does not exist"
  before=$(newest_run workflow_dispatch) || fail "gh cannot list the runs of $workflow"
  gh workflow run "$workflow" --ref main -f tag="$tag" >&2
  run=$(wait_for_new_run workflow_dispatch "$before") || fail "the release build of $tag did not start; see the Actions tab"
  files=$(release_files "$run") || fail "the release files of $tag did not build, check or sign; nothing was uploaded"
  if gh release view "$tag" >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    gh release upload "$tag" $files --clobber
    echo "attached to $tag: $files"
  else
    write_notes || fail "the release notes of $tag could not be written; nothing was published"
    # shellcheck disable=SC2086
    gh release create "$tag" --verify-tag --title "Stopan $tag" --notes-file "$notes" $files
  fi
  exit 0
fi

[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || fail "releases are made from main"
git diff --quiet && git diff --cached --quiet || fail "tracked files have uncommitted changes; commit or stash them first"
git fetch -q origin main --tags
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || fail "HEAD differs from origin/main; push or pull first"
! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || fail "tag $tag already exists"

make check

git tag -s "$tag" -m "Stopan $tag"
git -c gpg.ssh.allowedSignersFile="$signers" tag -v "$tag" ||
  { git tag -d "$tag" >/dev/null; fail "the signature of $tag did not verify; the tag was deleted and nothing was pushed"; }
write_notes ||
  { git tag -d "$tag" >/dev/null; fail "the release notes of $tag could not be written; the tag was deleted and nothing was pushed"; }
before=$(newest_run push) ||
  { git tag -d "$tag" >/dev/null; fail "gh cannot list the runs of $workflow; the tag was deleted and nothing was pushed"; }

git push origin "$tag"
retry="fix the cause, then make release-files VERSION=$version"
run=$(wait_for_new_run push "$before") ||
  fail "$tag is pushed, but its release build did not start (see the Actions tab); $retry"
files=$(release_files "$run") ||
  fail "$tag is pushed, but its release files did not build, check or sign; nothing was published; $retry"
# shellcheck disable=SC2086
gh release create "$tag" --verify-tag --latest --title "Stopan $tag" --notes-file "$notes" $files
