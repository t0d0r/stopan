#!/bin/sh
# Refuses a commit whose staged changes contain a secret (../AGENTS.md).
# Installed by `make hooks` (git config core.hooksPath .githooks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit refused." >&2
  echo "pre-commit: install it, or commit with --no-verify if you accept the risk." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --log-level warn .
