# Copy to .env (never commit .env). Used by compose.yaml.

# Empty values below are generated by bin/setup-env (run by make run and
# make docker-up): SECRET_KEY_BASE, ADMIN_EMAIL, ADMIN_USERNAME, ADMIN_PASSWORD.

# Signs sessions and cookies. Or generate with: bin/rails secret
SECRET_KEY_BASE=

# Host used in links inside emails (password reset, notifications).
APP_HOST=localhost
MAILER_SENDER=no-reply@localhost

# Outgoing email (specs/notifications.md). Without SMTP_ADDRESS no email
# is sent. Authentication is used only when SMTP_USERNAME is set.
# SMTP_TLS=true for implicit TLS (port 465); otherwise STARTTLS.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_TLS=false
SMTP_DOMAIN=

# Admin user, created on start when no user with ADMIN_USERNAME exists.
# Changing the values later does not change an existing user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Let anyone create an account (as a requester without an organization).
# Closed by default in production.
REGISTRATION_OPEN=false

# Set both to true when a TLS-terminating proxy is in front of the app.
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# Password for every user created by `make demo` (development only).
DEMO_PASSWORD=
